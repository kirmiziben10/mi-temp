{
  "name": "mi-temperature-monitor",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Web + Android app for the Xiaomi Mi Temperature and Humidity Monitor 2 (LYWSD03MMC): live readings, on-device history sync and bind-key activation over Bluetooth LE.",
  "author": "kirmiziben10",
  "license": "MIT",
  "homepage": "https://github.com/kirmiziben10/mi-temp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirmiziben10/mi-temp.git"
  },
  "keywords": [
    "xiaomi",
    "lywsd03mmc",
    "bluetooth",
    "web-bluetooth",
    "capacitor",
    "android",
    "react"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "android:sync": "vite build && cap sync android",
    "android:open": "cap open android",
    "android:run": "vite build && cap run android",
    "android:apk": "vite build && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-bluetooth": "^0.0.22",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
